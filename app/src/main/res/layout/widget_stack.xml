<?xml version="1.0" encoding="utf-8"?>
<!-- The stack must be laid out left-to-right: StackView's card offsets break in RTL (the cards overlapped).
     Each page sets its own RTL direction inside the card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <StackView
        android:id="@+id/w_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:loopViews="true" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/w_card"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/w_empty"
        android:textColor="@color/w_ink2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/w_refresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|left"
        android:layout_margin="9dp"
        android:background="@drawable/w_btn_bg"
        android:contentDescription="refresh"
        android:padding="7dp"
        android:src="@drawable/w_refresh" />
</FrameLayout>
