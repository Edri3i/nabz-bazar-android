<?xml version="1.0" encoding="utf-8"?>
<!-- One full-size card at a time; ▲ ▼ flip the pages, ⟳ refreshes. Every card is the same size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <AdapterViewFlipper
        android:id="@+id/w_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@animator/w_in"
        android:outAnimation="@animator/w_out"
        android:loopViews="true" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/w_card"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/w_empty"
        android:textColor="@color/w_ink2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/w_btn_bg"
            android:contentDescription="refresh"
            android:padding="7dp"
            android:src="@drawable/w_refresh" />

        <ImageView
            android:id="@+id/w_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/w_btn_bg"
            android:contentDescription="previous"
            android:padding="7dp"
            android:src="@drawable/w_up" />

        <ImageView
            android:id="@+id/w_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/w_btn_bg"
            android:contentDescription="next"
            android:padding="7dp"
            android:src="@drawable/w_down" />
    </LinearLayout>
</FrameLayout>
